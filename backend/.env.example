# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# === CORS / app ===
BACKEND_ALLOWED_ORIGINS=http://localhost:3010
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# === Дефолты для seed (применяются при первом запуске, если БД пустая) ===
# Xiaomi MiMo v2.5-pro — приоритетный провайдер (memory/llm-providers.md).
DEFAULT_LLM_ENDPOINT=https://api.xiaomimimo.com/v1
DEFAULT_LLM_MODEL=mimo-v2.5-pro
DEFAULT_LLM_TEMPERATURE=0.3

# API-ключ дефолтного провайдера. Если задан — backend сам подставит его в
# LLM-вызовы, когда frontend не передал свой ключ. UI видит `has_env_api_key`
# и не требует ввода ключа в форме настроек («прописал один раз — забыл»).
# Сам ключ НИКОГДА не возвращается клиенту, только bool-флаг.
DEFAULT_LLM_API_KEY=

# Локальный MCP_Toolkit EPF — по умолчанию слушает порт 6010.
DEFAULT_MCP_NAME=Транзит
DEFAULT_MCP_ENDPOINT=http://localhost:6010/mcp
DEFAULT_MCP_KIND=embedded

# Выключить автосидирование (только для unit-тестов).
# SEED_ON_STARTUP=false
