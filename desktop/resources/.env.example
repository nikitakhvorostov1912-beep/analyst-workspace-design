# =============================================================================
# 1С Аналитик — backend env (шаблон)
# =============================================================================
#
# Скопируй этот файл в `.env` рядом с backend.exe ТОЛЬКО если хочешь зашить
# свои ключи на уровне системы (вместо ввода через UI).
#
# Иначе — просто оставь как есть. При первом запуске откроется onboarding,
# где ты вводишь ключ от выбранного LLM-провайдера. Ключ сохраняется в
# защищённое локальное хранилище приложения.
#
# Файл `.env` НЕ копируется в коммерческий installer (см. electron-builder.yml,
# W1.1 fix 2026-05-22).
# =============================================================================

# --- LLM (выбор провайдера + ключ) ---
# Универсальный ключ (используется когда provider не имеет специализированного).
# Исторически — Xiaomi MiMo (api.xiaomimimo.com).
# DEFAULT_LLM_API_KEY=

# Per-provider ключи. Backend сам выбирает нужный по endpoint.
# Можно заполнить все или ни одного — UI всё равно даст ввести в onboarding.
# DEFAULT_LLM_API_KEY_NVIDIA=
# DEFAULT_LLM_API_KEY_OPENAI=
# DEFAULT_LLM_API_KEY_OPENROUTER=

# Provider endpoint / модель по умолчанию (можно поменять через UI настроек):
# DEFAULT_LLM_ENDPOINT=https://api.xiaomimimo.com/v1
# DEFAULT_LLM_MODEL=mimo-v2.5-pro
# DEFAULT_LLM_TEMPERATURE=0.3

# --- MCP (подключение к 1С) ---
# По умолчанию подключаемся к встроенному MCP Toolkit EPF на :6010.
# DEFAULT_MCP_NAME=Моя база 1С
# DEFAULT_MCP_ENDPOINT=http://localhost:6010/mcp
# DEFAULT_MCP_KIND=embedded
# DEFAULT_MCP_ANON_ENABLED=false

# --- CORS (production fail-secure) ---
# Для production ОБЯЗАТЕЛЬНО задать явно. Dev по умолчанию открывает localhost:3010.
# BACKEND_ALLOWED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010

# --- Системные ---
# LOG_LEVEL=INFO
# SEED_ON_STARTUP=true
# LEARNING_ENABLED=true
# MEMORY_ENABLED=true
# COMPRESSION_ENABLED=true
# ITERATION_BUDGET=100
